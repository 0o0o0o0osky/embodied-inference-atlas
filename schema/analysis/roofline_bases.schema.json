    "type": "object",
    "required": [
      "schema_version",
      "basis_id",
      "label",
      "level",
      "scenario_id",
      "precision_path_id",
      "ceiling_id",
      "bandwidth_ceiling_id",
      "device_id",
      "operating_point_id",
      "work_unit",
      "time_basis",
      "traffic_basis",
      "work_basis",
      "aggregation",
      "runtime_overhead",
      "runtime_id",
      "realization_id",
      "run_id",
      "capture_id",
      "comparison_mode",
      "provenance",
      "missing"
