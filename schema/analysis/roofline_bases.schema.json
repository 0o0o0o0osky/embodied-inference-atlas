      },
      "ceiling_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 160
      },
      "bandwidth_ceiling_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 160
      },
      "device_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 80
      },
      "operating_point_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 160
      },
      "work_unit": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "action_chunk",
          "denoise_step",
          "operator_invocation",
          "execution_group",
          "kernel_launch"
        ]
      },
      "time_basis": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "analytical_roof",
          "legacy_analytical_prediction",
          "wall_clock",
          "cuda_event",
          "nsys_interval",
          "ncu_kernel"
        ]
      },
      "traffic_basis": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "atomic_materialized",
          "fused_boundary_modeled",
          "kernel_boundary_modeled",
          "system_memory_measured",
          "l2_measured",
          "legacy_inverse_roofline",
          "legacy_custom_resident_score"
        ]
      },
      "work_basis": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "logical_formula",
          "runtime_executed_formula",
          "hardware_counter",
          "legacy_component_aggregate"
        ]
      },
      "aggregation": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "entity",
          "dag_resource_and_critical_path"
        ]
      },
      "runtime_overhead": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "included",
          "excluded",
          "not_applicable",
          "unknown"
        ]
      },
      "runtime_id": {
        "type": [
          "string",
          "null"
        ],
        "min_length": 1,
        "max_length": 80
      },
      "realization_id": {
        "type": [
          "string",
          "null"
        ],
        "min_length": 1,
        "max_length": 160
      },
      "run_id": {
        "type": [
          "string",
          "null"
        ],
        "min_length": 1,
        "max_length": 160
      },
      "capture_id": {
        "type": [
          "string",
          "null"
        ],
        "min_length": 1,
        "max_length": 160
      },
