        "additional_properties": false,
        "properties": {
          "evidence": {
            "type": "string",
            "min_length": 1,
            "max_length": 240,
            "enum": [
              "measured_local",
              "analytical",
              "reported_external"
            ]
          },
          "class": {
            "type": "string",
            "min_length": 1,
            "max_length": 240,
            "enum": [
              "published_fact",
              "mode_scaled_analytical",
              "analytical_model",
              "legacy_tool_assumption",
              "measured_empirical",
              "missing"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "min_length": 1,
              "max_length": 80
            }
          },
          "derivation": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind",
              "expression",
              "input_refs"
            ],
            "additional_properties": false,
            "properties": {
              "kind": {
                "type": "string",
                "min_length": 1,
                "max_length": 240,
                "enum": [
                  "divide_sparse_peak",
                  "scale_by_clock",
                  "scale_by_emc",
                  "legacy_copy",
                  "formula"
                ]
              },
              "expression": {
                "type": "string",
                "min_length": 1,
                "max_length": 500
              },
              "input_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "min_length": 1,
                  "max_length": 300
                }
              }
            }
          },
          "condition": {
            "type": [
              "string",
              "null"
            ],
            "min_length": 1,
            "max_length": 500
          }
        }
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "field",
            "reason",
            "detail"
          ],
          "additional_properties": false,
          "properties": {
            "field": {
              "type": "string",
              "min_length": 1,
              "max_length": 300
            },
            "reason": {
              "type": "string",
              "min_length": 1,
              "max_length": 240,
              "enum": [
                "not_applicable",
                "not_collected",
                "not_reported",
                "unsupported",
                "unavailable_from_source",
                "incompatible_basis",
                "ambiguous_mapping",
                "missing_compute_ceiling",
                "missing_traffic",
                "missing_work",
                "unfrozen_dependency"
              ]
            },
            "detail": {
              "type": "string",
              "min_length": 1,
              "max_length": 500
            }
          }
        }
      }
    }
  }
}
