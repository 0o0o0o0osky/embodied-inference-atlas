    "properties": {
      "schema_version": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "2.0.0"
        ]
      },
      "basis_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 200
      },
      "label": {
        "type": "string",
        "min_length": 1,
        "max_length": 300
      },
      "level": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "stage",
          "atomic",
          "fused",
          "kernel"
        ]
      },
      "scenario_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 160
      },
      "precision_path_id": {
        "type": "string",
        "min_length": 1,
        "max_length": 240,
        "enum": [
          "bf16_dense",
          "fp16_dense",
          "fp8_w8a8",
          "nvfp4_w4a4",
          "w8a16_bf16_compute",
          "w4a16_bf16_compute",
          "q8_0_weight_only_bf16_compute",
          "runtime_mixed"
