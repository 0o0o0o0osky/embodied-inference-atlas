{
  "dataset": "timelines",
  "record": {
    "type": "object",
    "required": ["timeline_id", "capture_id", "run_id", "source_id", "window", "time_basis", "lanes", "events", "summaries", "missing"],
    "additional_properties": false,
    "properties": {
      "timeline_id": {"type": "string", "min_length": 1, "max_length": 120},
      "capture_id": {"type": "string", "min_length": 1, "max_length": 120},
      "run_id": {"type": "string", "min_length": 1, "max_length": 120},
      "source_id": {"type": "string", "min_length": 1, "max_length": 80},
      "window": {
        "type": "object",
        "required": ["label", "start_ns", "duration_ns"],
        "additional_properties": false,
        "properties": {
          "label": {"type": "string", "enum": ["predict"]},
          "start_ns": {"type": "integer", "minimum": 0},
          "duration_ns": {"type": "integer", "minimum": 1}
        }
      },
      "time_basis": {"type": "string", "enum": ["relative_to_target_window_start"]},
      "lanes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["lane_id", "kind", "role", "ordinal", "coverage"],
          "additional_properties": false,
          "properties": {
            "lane_id": {"type": "string", "min_length": 1, "max_length": 80},
            "kind": {"type": "string", "enum": ["cpu_thread", "cpu_aggregate", "cuda_api", "cuda_graph", "gpu_kernel", "gpu_memcpy", "profiler_overhead"]},
            "role": {"type": "string", "enum": ["target-main", "target-worker", "cuda-event-handler", "non-profiler-all-processes", "graph-execution", "kernel-stream", "copy-stream", "profiler-excluded"]},
            "ordinal": {"type": "integer", "minimum": 0},
            "coverage": {"type": "string", "enum": ["complete", "partial", "excluded"]}
          }
        }
      },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["event_id", "lane_id", "event_kind", "label", "start_ns", "duration_ns", "count", "kernel_signature_id", "bytes", "copy_direction", "evidence_semantics"],
          "additional_properties": false,
          "properties": {
            "event_id": {"type": "string", "min_length": 1, "max_length": 80},
            "lane_id": {"type": "string", "min_length": 1, "max_length": 80},
            "event_kind": {"type": "string", "enum": ["scheduler", "cuda_api", "cuda_graph", "kernel", "memcpy", "profiler_overhead"]},
            "label": {"type": "string", "enum": ["predict", "vision-graph", "encoder-action-graph", "cuda-device-synchronize", "cuda-graph-launch", "kernel", "memcpy"]},
            "start_ns": {"type": "integer", "minimum": 0},
            "duration_ns": {"type": "integer", "minimum": 1},
            "count": {"type": "integer", "minimum": 1},
            "kernel_signature_id": {"type": ["string", "null"], "min_length": 1, "max_length": 120},
            "bytes": {"type": ["integer", "null"], "minimum": 0},
            "copy_direction": {"type": ["string", "null"], "enum": ["h2d", "d2h", "d2d", "h2h", "unknown", null]},
            "evidence_semantics": {"type": "string", "enum": ["exact_interval", "cuda_graph_execution_span", "scheduler_running_interval", "aggregated_interval"]}
          }
        }
      },
      "summaries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["metric_name", "value", "unit", "denominator", "derivation_version", "input_refs"],
          "additional_properties": false,
          "properties": {
            "metric_name": {"type": "string", "enum": ["cuda_graph_span_union", "inter_graph_gap", "outside_graph_span_union", "cuda_device_synchronize_wall_duration", "cuda_graph_launch_wall_duration", "kernel_duration_sum", "recorded_gpu_activity_union", "recorded_copy_activity_union", "target_scheduled_core_time_overlapping_recorded_gpu_activity", "target_wall_overlap_with_recorded_gpu_activity", "target_scheduled_core_time_overlapping_graph_spans", "target_scheduled_core_time_over_full_window", "non_profiler_scheduled_core_time_during_graph_spans", "non_profiler_equivalent_scheduled_cores_during_graph_spans", "non_profiler_scheduled_capacity_share_during_graph_spans", "non_profiler_wall_overlap_with_graph_spans", "profiler_scheduled_core_time_during_graph_spans"]},
            "value": {"type": "number", "minimum": 0},
            "unit": {"type": "string", "enum": ["ns", "percent", "cores"]},
            "denominator": {"type": "string", "enum": ["predict_window", "adjacent_graph_spans", "kernel_duration_sum", "recorded_gpu_activity_union", "cuda_graph_span_union", "logical_cpu_capacity_during_graph_spans", "none"]},
            "derivation_version": {"type": "string", "enum": ["interval-union-v1", "interval-gap-v1", "interval-complement-v1", "interval-sum-v1", "interval-intersection-v1", "interval-ratio-v1"]},
            "input_refs": {"type": "array", "items": {"type": "string", "min_length": 1, "max_length": 80}}
          }
        }
      },
      "missing": {
        "type": "object",
        "required": [],
        "additional_properties": false,
        "properties": {
          "exact_gpu_busy_union": {"type": "string", "enum": ["graph_node_trace_not_collected"]},
          "gpu_kernel_lane": {"type": "string", "enum": ["not_collected_at_trace_mode"]},
          "cpu_idle_conclusion": {"type": "string", "enum": ["not_computable_from_scheduler_activity"]},
          "kernel_signature_coverage": {"type": "string", "enum": ["unclassified_raw_symbols"]}
        }
      }
    }
  }
}
