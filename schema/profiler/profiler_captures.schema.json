{
  "dataset": "profiler_captures",
  "record": {
    "type": "object",
    "required": ["capture_id", "run_id", "source_id", "evidence", "tool", "tool_version", "collection_scope", "target_window_label", "target_window_count", "selection_policy", "coverage", "warnings", "nsys", "ncu", "missing"],
    "additional_properties": false,
    "properties": {
      "capture_id": {"type": "string", "min_length": 1, "max_length": 120},
      "run_id": {"type": "string", "min_length": 1, "max_length": 120},
      "source_id": {"type": "string", "min_length": 1, "max_length": 80},
      "evidence": {"type": "string", "enum": ["measured_local"]},
      "tool": {"type": "string", "enum": ["nsys", "ncu"]},
      "tool_version": {"type": "string", "min_length": 1, "max_length": 40},
      "collection_scope": {"type": "string", "enum": ["prediction_window", "representative_kernel_launch"]},
      "target_window_label": {"type": ["string", "null"], "enum": ["predict", null]},
      "target_window_count": {"type": "integer", "minimum": 1},
      "selection_policy": {"type": "string", "enum": ["explicit_invocation", "name_filter_selected_match", "single_predict_window"]},
      "coverage": {
        "type": "object",
        "required": ["population", "observed_count", "is_complete_for_population"],
        "additional_properties": false,
        "properties": {
          "population": {"type": "string", "enum": ["one_profiled_prediction", "one_replayed_launch"]},
          "observed_count": {"type": "integer", "minimum": 0},
          "is_complete_for_population": {"type": "boolean"}
        }
      },
      "warnings": {
        "type": "array",
        "items": {"type": "string", "enum": ["gpu_frequency_not_fixed", "intrusive_node_trace", "profiler_scheduler_activity_present", "work_id_unavailable", "partial_kernel_signature_coverage"]}
      },
      "nsys": {
        "type": ["object", "null"],
        "required": ["report_mode", "scheduler_scope", "logical_cpu_count", "cuda_graph_trace_present", "graph_node_trace_present", "scheduler_trace_present", "profiler_overhead_trace_present"],
        "additional_properties": false,
        "properties": {
          "report_mode": {"type": "string", "enum": ["graph", "node"]},
          "scheduler_scope": {"type": "string", "enum": ["process_tree", "system_wide"]},
          "logical_cpu_count": {"type": "integer", "minimum": 1},
          "cuda_graph_trace_present": {"type": "boolean"},
          "graph_node_trace_present": {"type": "boolean"},
          "scheduler_trace_present": {"type": "boolean"},
          "profiler_overhead_trace_present": {"type": "boolean"}
        }
      },
      "ncu": {
        "type": ["object", "null"],
        "required": ["replay_mode", "replay_passes", "cache_control_request", "clock_control_request", "warmup_count", "backing_store_bytes", "origins"],
        "additional_properties": false,
        "properties": {
          "replay_mode": {"type": "string", "enum": ["kernel"]},
          "replay_passes": {"type": "integer", "minimum": 1},
          "cache_control_request": {"type": "string", "enum": ["all"]},
          "clock_control_request": {"type": "string", "enum": ["base", "none"]},
          "warmup_count": {"type": "integer", "minimum": 0},
          "backing_store_bytes": {"type": ["integer", "null"], "minimum": 0},
          "disable_extra_suffixes": {"type": "boolean"},
          "section_mode": {"type": "string", "enum": ["scheduler_stats_with_sysmem_sectors", "warp_state_stats"]},
          "sections": {
            "type": "array",
            "items": {"type": "string", "enum": ["SpeedOfLight", "ComputeWorkloadAnalysis", "MemoryWorkloadAnalysis", "LaunchStats", "Occupancy", "SchedulerStats", "WarpStateStats"]}
          },
          "explicit_metrics": {
            "type": "array",
            "items": {"type": "string", "enum": ["lts__d_sectors_fill_sysmem.sum", "lts__t_sectors_aperture_sysmem_op_write.sum", "lts__t_sectors_srcunit_tex_aperture_sysmem_lookup_miss.sum"]}
          },
          "external_clock_control": {
            "type": "object",
            "required": ["controller", "state"],
            "additional_properties": false,
            "properties": {
              "controller": {"type": "string", "enum": ["jetson_clocks"]},
              "state": {"type": "string", "enum": ["locked"]}
            }
          },
          "warp_trigger": {
            "type": "object",
            "required": ["scheduler_capture_id", "scheduler_observation_id", "origin", "criteria", "launch_occupancy_review"],
            "additional_properties": false,
            "properties": {
              "scheduler_capture_id": {"type": "string", "min_length": 1, "max_length": 120},
              "scheduler_observation_id": {"type": "string", "min_length": 1, "max_length": 120},
              "origin": {"type": "string", "enum": ["reviewed_scheduler_evidence"]},
              "criteria": {
                "type": "array",
                "min_items": 3,
                "max_items": 3,
                "items": {
                  "type": "object",
                  "required": ["metric_name", "operator", "threshold", "observed_value"],
                  "additional_properties": false,
                  "properties": {
                    "metric_name": {"type": "string", "enum": ["scheduler_issue_active_per_active_cycle", "scheduler_active_warps_per_active_cycle", "scheduler_eligible_warps_per_active_cycle"]},
                    "operator": {"type": "string", "enum": ["lt", "gte"]},
                    "threshold": {"type": "number", "minimum": 0},
                    "observed_value": {"type": "number", "minimum": 0}
                  }
                }
              },
              "launch_occupancy_review": {
                "type": "object",
                "required": ["conclusion", "basis", "evidence_fields"],
                "additional_properties": false,
                "properties": {
                  "conclusion": {"type": "string", "enum": ["launch_and_occupancy_do_not_explain_issue_gap"]},
                  "basis": {"type": "string", "enum": ["manual_review_of_same_capture_evidence"]},
                  "evidence_fields": {
                    "type": "array",
                    "min_items": 3,
                    "max_items": 3,
                    "items": {"type": "string", "enum": ["kernel_observation.launch", "theoretical_occupancy_percent", "achieved_occupancy_percent"]}
                  }
                }
              }
            }
          },
          "origins": {
            "type": "object",
            "required": ["selection_policy", "replay_mode", "replay_passes", "cache_control_request", "clock_control_request", "warmup_count", "backing_store_bytes"],
            "additional_properties": false,
            "properties": {
              "selection_policy": {"type": "string", "enum": ["session_command"]},
              "replay_mode": {"type": "string", "enum": ["session_command", "ncu_cli_default_2025_3"]},
              "replay_passes": {"type": "string", "enum": ["collection_log_manual_audit"]},
              "cache_control_request": {"type": "string", "enum": ["session_command", "ncu_cli_default_2025_3"]},
              "clock_control_request": {"type": "string", "enum": ["session_command", "ncu_cli_default_2025_3"]},
              "warmup_count": {"type": "string", "enum": ["harness_source_audit"]},
              "backing_store_bytes": {"type": "string", "enum": ["unavailable"]},
              "gpu_frequency_not_fixed": {"type": "string", "enum": ["collection_log_manual_audit"]},
              "disable_extra_suffixes": {"type": "string", "enum": ["session_command"]},
              "external_clock_control": {"type": "string", "enum": ["collection_wrapper_observed"]}
            }
          }
        }
      },
      "missing": {
        "type": "object",
        "required": [],
        "additional_properties": false,
        "properties": {
          "target_window_label": {"type": "string", "enum": ["not_applicable"]},
          "nsys": {"type": "string", "enum": ["not_applicable"]},
          "ncu": {"type": "string", "enum": ["not_applicable"]},
          "ncu.backing_store_bytes": {"type": "string", "enum": ["unavailable"]}
        }
      }
    }
  }
}
