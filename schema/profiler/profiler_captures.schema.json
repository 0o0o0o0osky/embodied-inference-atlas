{
  "dataset": "profiler_captures",
  "record": {
    "type": "object",
    "required": ["capture_id", "run_id", "source_id", "evidence", "tool", "tool_version", "collection_scope", "target_window_label", "target_window_count", "selection_policy", "coverage", "warnings", "nsys", "ncu", "missing"],
    "additional_properties": false,
    "properties": {
      "capture_id": {"type": "string", "min_length": 1, "max_length": 120},
      "run_id": {"type": "string", "min_length": 1, "max_length": 120},
      "source_id": {"type": "string", "min_length": 1, "max_length": 80},
      "evidence": {"type": "string", "enum": ["measured_local"]},
      "tool": {"type": "string", "enum": ["nsys", "ncu"]},
      "tool_version": {"type": "string", "min_length": 1, "max_length": 40},
      "collection_scope": {"type": "string", "enum": ["prediction_window", "representative_kernel_launch"]},
      "target_window_label": {"type": ["string", "null"], "enum": ["predict", null]},
      "target_window_count": {"type": "integer", "minimum": 1},
      "selection_policy": {"type": "string", "enum": ["explicit_invocation", "name_filter_first_match", "single_predict_window"]},
      "coverage": {
        "type": "object",
        "required": ["population", "observed_count", "is_complete_for_population"],
        "additional_properties": false,
        "properties": {
          "population": {"type": "string", "enum": ["one_profiled_prediction", "one_replayed_launch"]},
          "observed_count": {"type": "integer", "minimum": 0},
          "is_complete_for_population": {"type": "boolean"}
        }
      },
      "warnings": {
        "type": "array",
        "items": {"type": "string", "enum": ["gpu_frequency_not_fixed", "intrusive_node_trace", "profiler_scheduler_activity_present", "work_id_unavailable", "partial_kernel_signature_coverage"]}
      },
      "nsys": {
        "type": ["object", "null"],
        "required": ["report_mode", "scheduler_scope", "logical_cpu_count", "cuda_graph_trace_present", "graph_node_trace_present", "scheduler_trace_present", "profiler_overhead_trace_present"],
        "additional_properties": false,
        "properties": {
          "report_mode": {"type": "string", "enum": ["graph", "node"]},
          "scheduler_scope": {"type": "string", "enum": ["process_tree", "system_wide"]},
          "logical_cpu_count": {"type": "integer", "minimum": 1},
          "cuda_graph_trace_present": {"type": "boolean"},
          "graph_node_trace_present": {"type": "boolean"},
          "scheduler_trace_present": {"type": "boolean"},
          "profiler_overhead_trace_present": {"type": "boolean"}
        }
      },
      "ncu": {
        "type": ["object", "null"],
        "required": ["replay_mode", "replay_passes", "cache_control_request", "clock_control_request", "warmup_count", "backing_store_bytes"],
        "additional_properties": false,
        "properties": {
          "replay_mode": {"type": "string", "enum": ["kernel"]},
          "replay_passes": {"type": "integer", "minimum": 1},
          "cache_control_request": {"type": "string", "enum": ["all"]},
          "clock_control_request": {"type": "string", "enum": ["base"]},
          "warmup_count": {"type": "integer", "minimum": 0},
          "backing_store_bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      },
      "missing": {
        "type": "object",
        "required": [],
        "additional_properties": false,
        "properties": {
          "target_window_label": {"type": "string", "enum": ["not_applicable"]},
          "nsys": {"type": "string", "enum": ["not_applicable"]},
          "ncu": {"type": "string", "enum": ["not_applicable"]},
          "ncu.backing_store_bytes": {"type": "string", "enum": ["counter_absent_from_report"]}
        }
      }
    }
  }
}
